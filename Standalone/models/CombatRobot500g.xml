<mujoco model="CombatRobot500g">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.0004" gravity="0 0 -9.80665" integrator="implicitfast"/>
  <visual><headlight ambient="0.12 0.12 0.12" diffuse="0.07 0.07 0.07" specular="0.008 0.008 0.008"/></visual>
  <default>
    <geom condim="3" solref="0.003 1" solimp="0.95 0.99 0.001"/>
    <joint damping="0.0001"/>
  </default>
  <asset>
    <material name="arena_floor_laminate" rgba="0.84 0.83 0.79 1" specular="0.06" shininess="0.12" reflectance="0"/>
    <material name="bot_painted_alloy" specular="0.50" shininess="0.42"/>
    <material name="bot_tire_rubber" specular="0.16" shininess="0.10"/>
    <material name="bot_machined_steel" specular="0.72" shininess="0.58"/>
    <material name="bot_tool_steel" specular="0.82" shininess="0.72"/>
  </asset>
  <worldbody>
    <light name="arena_key_light" directional="true" castshadow="false" pos="0 0 2" dir="0.3 -0.4 -1" diffuse="0.88 0.85 0.78" specular="0.18 0.18 0.18" ambient="0.01 0.01 0.01"/>
    <light name="arena_fill_light" directional="true" castshadow="false" pos="0 0 2" dir="-0.5 0.3 -1" diffuse="0.42 0.48 0.54" specular="0.035 0.035 0.035" ambient="0.005 0.005 0.005"/>
    <geom name="floor" type="plane" size="0 0 0.02" rgba="0 0 0 0" friction="1.4 0.02 0.001"/>
    <geom name="floor_visual" type="box" pos="0 0 -0.001" size="1 1 0.001" material="arena_floor_laminate" contype="0" conaffinity="0"/>
    <!-- Hidden deep collision volumes catch fast impacts; the visible acrylic skins are 8 mm thick. -->
    <geom name="north_wall" type="box" pos="0 1.30 0.5" size="1.62 0.30 0.55" margin="0.01" solref="0.001 1" solimp="0.99 0.999 0.001" rgba="0.5 0.58 0.58 0"/>
    <geom name="south_wall" type="box" pos="0 -1.30 0.5" size="1.62 0.30 0.55" margin="0.01" solref="0.001 1" solimp="0.99 0.999 0.001" rgba="0.5 0.58 0.58 0"/>
    <geom name="east_wall" type="box" pos="1.30 0 0.5" size="0.30 1.62 0.55" margin="0.01" solref="0.001 1" solimp="0.99 0.999 0.001" rgba="0.5 0.58 0.58 0"/>
    <geom name="west_wall" type="box" pos="-1.30 0 0.5" size="0.30 1.62 0.55" margin="0.01" solref="0.001 1" solimp="0.99 0.999 0.001" rgba="0.5 0.58 0.58 0"/>
    <geom name="north_wall_acrylic" type="box" pos="0 1.004 0.5" size="1 0.004 0.5" contype="0" conaffinity="0" rgba="0.57 0.66 0.66 0.11"/>
    <geom name="south_wall_acrylic" type="box" pos="0 -1.004 0.5" size="1 0.004 0.5" contype="0" conaffinity="0" rgba="0.57 0.66 0.66 0.11"/>
    <geom name="east_wall_acrylic" type="box" pos="1.004 0 0.5" size="0.004 1 0.5" contype="0" conaffinity="0" rgba="0.57 0.66 0.66 0.11"/>
    <geom name="west_wall_acrylic" type="box" pos="-1.004 0 0.5" size="0.004 1 0.5" contype="0" conaffinity="0" rgba="0.57 0.66 0.66 0.11"/>
    <geom name="roof" type="box" pos="0 0 1.125" size="1.62 1.62 0.175" rgba="0.5 0.58 0.58 0"/>
    <geom name="roof_acrylic" type="box" pos="0 0 1.004" size="1 1 0.004" contype="0" conaffinity="0" rgba="0.57 0.66 0.66 0.07"/>
    <body name="Player_Robot" pos="-0.68 0 0.065">
      <freejoint name="robot_free"/>
      <geom name="chassis" type="box" size="0.17 0.13 0.045" mass="0.350" friction="0.7 0.02 0.001" material="bot_painted_alloy" rgba="0 0.68 0.86 1"/>
      <body name="front_left_wheel" pos="0.105 0.145 -0.02">
        <joint name="front_left_axle" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.045 0.0175" euler="1.57079632679 0 0" mass="0.0075" friction="0.8 0.02 0.001" material="bot_tire_rubber" rgba="0.12 0.13 0.16 1"/>
      </body>
      <body name="rear_left_wheel" pos="-0.105 0.145 -0.02">
        <joint name="rear_left_axle" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.045 0.0175" euler="1.57079632679 0 0" mass="0.0075" friction="0.8 0.02 0.001" material="bot_tire_rubber" rgba="0.12 0.13 0.16 1"/>
      </body>
      <body name="front_right_wheel" pos="0.105 -0.145 -0.02">
        <joint name="front_right_axle" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.045 0.0175" euler="1.57079632679 0 0" mass="0.0075" friction="0.8 0.02 0.001" material="bot_tire_rubber" rgba="0.12 0.13 0.16 1"/>
      </body>
      <body name="rear_right_wheel" pos="-0.105 -0.145 -0.02">
        <joint name="rear_right_axle" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.045 0.0175" euler="1.57079632679 0 0" mass="0.0075" friction="0.8 0.02 0.001" material="bot_tire_rubber" rgba="0.12 0.13 0.16 1"/>
      </body>
      <body name="vertical_drum" pos="0.225 0 0.005">
        <joint name="weapon_axle" type="hinge" axis="0 1 0" damping="0.0000001"/>
        <!-- 80 mm diameter, 180 mm long steel drum core: 100 g. -->
        <geom name="drum_core" type="cylinder" size="0.040 0.090" euler="1.57079632679 0 0" mass="0.100" friction="0.8 0.02 0.001" material="bot_machined_steel" rgba="0.72 0.36 0.12 1"/>
        <!-- Opposed impact teeth bring weapon mass to 120 g and create a 104 mm OD. -->
        <geom name="drum_tooth_a" type="box" pos="0.0415 0 0" size="0.0105 0.090 0.0105" mass="0.010" friction="0.8 0.02 0.001" material="bot_tool_steel" rgba="1 0.69 0.16 1"/>
        <geom name="drum_tooth_b" type="box" pos="-0.0415 0 0" size="0.0105 0.090 0.0105" mass="0.010" friction="0.8 0.02 0.001" material="bot_tool_steel" rgba="1 0.69 0.16 1"/>
      </body>
    </body>
    <!-- Stationary 500 g target. Its unpowered joints let it roll and recoil
         when hit, while the player robot remains the only controlled robot. -->
    <body name="Target_Robot" pos="0.68 0 0.065" quat="0 0 0 1">
      <freejoint name="target_free"/>
      <geom name="target_chassis" type="box" size="0.17 0.13 0.045" mass="0.350" friction="0.7 0.02 0.001" material="bot_painted_alloy" rgba="0.82 0.16 0.14 1"/>
      <body name="target_front_left_wheel" pos="0.105 0.145 -0.02">
        <joint name="target_front_left_axle" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.045 0.0175" euler="1.57079632679 0 0" mass="0.0075" friction="0.8 0.02 0.001" material="bot_tire_rubber" rgba="0.12 0.13 0.16 1"/>
      </body>
      <body name="target_rear_left_wheel" pos="-0.105 0.145 -0.02">
        <joint name="target_rear_left_axle" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.045 0.0175" euler="1.57079632679 0 0" mass="0.0075" friction="0.8 0.02 0.001" material="bot_tire_rubber" rgba="0.12 0.13 0.16 1"/>
      </body>
      <body name="target_front_right_wheel" pos="0.105 -0.145 -0.02">
        <joint name="target_front_right_axle" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.045 0.0175" euler="1.57079632679 0 0" mass="0.0075" friction="0.8 0.02 0.001" material="bot_tire_rubber" rgba="0.12 0.13 0.16 1"/>
      </body>
      <body name="target_rear_right_wheel" pos="-0.105 -0.145 -0.02">
        <joint name="target_rear_right_axle" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.045 0.0175" euler="1.57079632679 0 0" mass="0.0075" friction="0.8 0.02 0.001" material="bot_tire_rubber" rgba="0.12 0.13 0.16 1"/>
      </body>
      <body name="target_vertical_drum" pos="0.225 0 0.005">
        <joint name="target_weapon_axle" type="hinge" axis="0 1 0" damping="0.00002"/>
        <geom name="target_drum_core" type="cylinder" size="0.040 0.090" euler="1.57079632679 0 0" mass="0.100" friction="0.8 0.02 0.001" material="bot_machined_steel" rgba="0.72 0.36 0.12 1"/>
        <geom name="target_drum_tooth_a" type="box" pos="0.0415 0 0" size="0.0105 0.090 0.0105" mass="0.010" friction="0.8 0.02 0.001" material="bot_tool_steel" rgba="1 0.69 0.16 1"/>
        <geom name="target_drum_tooth_b" type="box" pos="-0.0415 0 0" size="0.0105 0.090 0.0105" mass="0.010" friction="0.8 0.02 0.001" material="bot_tool_steel" rgba="1 0.69 0.16 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <velocity name="front_left_drive" joint="front_left_axle" kv="0.004" forcerange="-0.08 0.08"/>
    <velocity name="rear_left_drive" joint="rear_left_axle" kv="0.004" forcerange="-0.08 0.08"/>
    <velocity name="front_right_drive" joint="front_right_axle" kv="0.004" forcerange="-0.08 0.08"/>
    <velocity name="rear_right_drive" joint="rear_right_axle" kv="0.004" forcerange="-0.08 0.08"/>
    <velocity name="weapon_drive" joint="weapon_axle" kv="0.001" forcerange="-0.25 0.25"/>
  </actuator>
</mujoco>
