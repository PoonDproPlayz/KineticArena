{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kineticarena-signaling",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "SignalingRoom" },
      { "name": "CREATE_LIMITS", "class_name": "CreateRateLimit" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingRoom", "CreateRateLimit"]
    }
  ]
}
